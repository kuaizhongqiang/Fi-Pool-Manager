{
  "name": "fi-pool-server",
  "version": "0.3.2",
  "description": "Fi-Pool-Manager 核心服务：数据获取、技术分析、LLM 分析引擎、向量检索",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "drizzle",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuaizhongqiang/Fi-Pool-Manager.git"
  },
  "keywords": [
    "a股",
    "股票",
    "量化分析",
    "技术分析",
    "llm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./dist/index.js",
    "./db/migrate.js": "./dist/db/migrate.js",
    "./tools/manager.js": "./dist/tools/manager.js",
    "./tools/query.js": "./dist/tools/query.js",
    "./tools/command.js": "./dist/tools/command.js",
    "./tools/execute.js": "./dist/tools/execute.js",
    "./tools/auxiliary.js": "./dist/tools/auxiliary.js",
    "./services/daily-summary.js": "./dist/services/daily-summary.js",
    "./services/daily-summary-v2.js": "./dist/services/daily-summary-v2.js",
    "./api/index.js": "./dist/api/index.js",
    "./utils/data-freshness.js": "./dist/utils/data-freshness.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.32.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
