# === 数据库 ===
DB_PATH=./data/fi-pool.db

# === LLM 推理（LM Studio / OpenAI 兼容） ===
# 端点: POST /v1/chat/completions, 标准 messages 格式
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=qwen/qwen3.5-9b
LLM_CONTEXT_LIMIT=262144

# === 向量嵌入（LM Studio / OpenAI 兼容） ===
# 端点: POST /v1/embeddings, 标准 OpenAI 格式
EMBEDDING_API_URL=http://127.0.0.1:1234/v1/embeddings
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=text-embedding-baai-bge-m3-568m

# === 行情数据 ===
DATA_FETCH_INTERVAL_MS=1200

# === 搜索/舆情（阿里云百炼 DashScope） ===
# 端点: POST /v1/chat/completions, 标准 OpenAI 格式
# enable_search=true 开启联网搜索
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEARCH_MODEL=qwen3.5-flash

# === 服务 ===
PORT=3000

# === 日志 ===
LOG_LEVEL=info
