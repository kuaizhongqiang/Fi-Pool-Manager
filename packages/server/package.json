{
  "name": "@fi-pool/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fi-Pool-Manager 核心服务：数据获取、分析引擎、LLM 调用、向量检索",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
